# Somente desenvolvimento local. Copie para .env (cp .env.example .env; no Windows: copy .env.example .env).
# O .env nunca vai para o Git. Troque estes valores se a máquina for compartilhada.
# Não use # nem $ nos valores: o # inicia comentário e o $ é interpolado pelo docker compose.

# Senha do usuário sa do SQL Server (mínimo 8 caracteres com maiúscula, minúscula, número e símbolo).
MSSQL_SA_PASSWORD=Dev@Sql2026!oficina

# Chave de assinatura dos JWT (mínimo 32 caracteres).
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# Segredo HMAC do webhook Pix simulado (usado pela API e pela carga de demonstração).
PIX_WEBHOOK_SECRET=dev-only-pix-webhook-secret

# Administrador criado na subida da API em Development.
DEV_ADMIN_EMAIL=admin@oficina.local
DEV_ADMIN_PASSWORD=Admin@Dev2026

# Senha dos usuários criados pela carga de demonstração (gerente, atendentes e mecânicos).
SEED_USERS_PASSWORD=Equipe@Dev2026

# SonarQube local (profile quality). O token é gerado pelo script scripts/sonar/run-analysis.mjs.
SONAR_ADMIN_PASSWORD=Sonar@Dev2026!local
SONAR_TOKEN=
