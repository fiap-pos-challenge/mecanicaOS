# Somente desenvolvimento local. Copie para .env (cp .env.example .env; no PowerShell: Copy-Item .env.example .env).
# O .env nunca vai para o Git. Troque estes valores se a máquina for compartilhada.
# Não use # nem $ nos valores: o # inicia comentário e o $ é interpolado pelo docker compose.

# Senha do usuário sa do SQL Server (mínimo 8 caracteres com maiúscula, minúscula, número e símbolo).
MSSQL_SA_PASSWORD=Dev@Sql2026!oficina

# Chave de assinatura dos JWT (mínimo 32 caracteres).
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
