{
  "name": "oficina-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:demo": "ng serve --configuration demo",
    "build": "ng build",
    "build:demo": "ng build --configuration production,demo --output-path dist/oficina-web-demo",
    "check:bundle": "node scripts/check-bundle.mjs dist/oficina-web/browser",
    "check:secrets": "cd .. && node web/scripts/check-secrets.mjs",
    "test": "ng test --watch=false --coverage && node --test \"scripts/*.test.mjs\"",
    "lint": "ng lint && node scripts/check-comments.mjs && node scripts/check-colors.mjs && prettier --check .",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "lighthouse:screens": "node scripts/lighthouse-screens.mjs",
    "api:generate": "node scripts/api-generate.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@microsoft/signalr": "^10.0.11",
    "@ngrx/signals": "^22.0.1",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "echarts": "^6.1.0",
    "lucide": "^1.52.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "22.5.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.0.0",
    "lighthouse": "^13.5.0",
    "msw": "^2.15.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "overrides": {
    "js-yaml": "^5.4.2",
    "vite": "8.3.5"
  }
}
