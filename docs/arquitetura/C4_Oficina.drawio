<mxfile host="app.diagrams.net" type="device"><diagram id="ctx" name="1. Contexto"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1350" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ctx-title" value="&lt;b&gt;[Diagrama de Contexto] Sistema Integrado de Atendimento e Execução de Serviços (mecanicaOS)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;C4 · Nível 1 · Visão geral do sistema da oficina mecânica, de quem o usa e com quais sistemas externos ele se comunica&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1800" height="60" as="geometry"/></mxCell><mxCell id="ctx-at" value="&lt;b style=&quot;font-size:12px&quot;&gt;Atendente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Recepção: atende o cliente, abre a O.S. e monta o orçamento" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctx-me" value="&lt;b style=&quot;font-size:12px&quot;&gt;Mecânico&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Diagnostica o veículo e executa os serviços" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="120" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctx-ge" value="&lt;b style=&quot;font-size:12px&quot;&gt;Gerente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Opera a oficina, acompanha resultados e aprova descontos" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctx-ad" value="&lt;b style=&quot;font-size:12px&quot;&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Administra equipe, configurações e segurança; pode tudo" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1380" y="120" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctx-cl" value="&lt;b style=&quot;font-size:12px&quot;&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Pessoa física ou jurídica (CPF/CNPJ) dona do veículo; não faz login" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="120" y="530" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctx-fo" value="&lt;b style=&quot;font-size:12px&quot;&gt;Fornecedor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Empresa que vende peças e insumos à oficina" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1820" y="900" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctx-sys" value="&lt;b style=&quot;font-size:12px&quot;&gt;Sistema Integrado de Atendimento e Execução de Serviços (mecanicaOS)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema de software]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Gestão da oficina: clientes e veículos, catálogo, estoque e compras, Ordens de Serviço com diagnóstico, orçamento, execução e entrega, portal do cliente com pagamento Pix, documentos, equipe, painel, financeiro, relatórios e automações" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="520" width="1100" height="190" as="geometry"/></mxCell><mxCell id="ctx-wa" value="&lt;b style=&quot;font-size:12px&quot;&gt;WhatsApp&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Aplicativo de mensagens usado para enviar o link do orçamento ao cliente" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="220" y="900" width="260" height="150" as="geometry"/></mxCell><mxCell id="ctx-em" value="&lt;b style=&quot;font-size:12px&quot;&gt;Servidor de E-mail&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Servidor SMTP que entrega e-mails a clientes, fornecedores e equipe" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="900" width="280" height="150" as="geometry"/></mxCell><mxCell id="ctx-cep" value="&lt;b style=&quot;font-size:12px&quot;&gt;ViaCEP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Serviço público de consulta de endereço por CEP" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1040" y="900" width="260" height="150" as="geometry"/></mxCell><mxCell id="ctx-pix" value="&lt;b style=&quot;font-size:12px&quot;&gt;Instituição de Pagamento (Pix)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Banco ou PSP que recebe o Pix. No MVP a confirmação é simulada (contrato próprio { txId } + HMAC); integração com PSP real: « To be implemented »" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="900" width="280" height="150" as="geometry"/></mxCell><mxCell id="ctx-fis" value="&lt;b style=&quot;font-size:12px&quot;&gt;Emissão Fiscal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Emissor de NFS-e, NF-e e NFC-e&lt;br&gt;&lt;br&gt;&lt;b&gt;« To be implemented »&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#8C8496;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#4A4A4A;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1710" y="440" width="280" height="140" as="geometry"/></mxCell><mxCell id="ctx-card" value="&lt;b style=&quot;font-size:12px&quot;&gt;Gateway de Cartão&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Processa pagamentos com cartão de crédito e débito&lt;br&gt;&lt;br&gt;&lt;b&gt;« To be implemented »&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#8C8496;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#4A4A4A;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1710" y="620" width="280" height="140" as="geometry"/></mxCell><mxCell id="ctx-e1" value="Cadastra clientes e veículos, abre a O.S.,&lt;br&gt;monta e envia orçamentos e entrega o veículo&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;entryX=0.09090909090909091;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-at" target="ctx-sys"><mxGeometry relative="1" x="-0.5" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e2" value="Registra diagnóstico, checklist, fotos&lt;br&gt;e tempo de trabalho e finaliza a O.S.&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;entryX=0.36363636363636365;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-me" target="ctx-sys"><mxGeometry relative="1" x="0.5" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e3" value="Acompanha painel, financeiro e relatórios,&lt;br&gt;aprova descontos e cuida de estoque e compras&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;entryX=0.6363636363636364;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-ge" target="ctx-sys"><mxGeometry relative="1" x="-0.5" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e4" value="Administra equipe, configurações,&lt;br&gt;segurança e automações&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;entryX=0.9090909090909091;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-ad" target="ctx-sys"><mxGeometry relative="1" x="0.5" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e5" value="Acompanha a O.S.,&lt;br&gt;aprova ou recusa o&lt;br&gt;orçamento, paga e&lt;br&gt;verifica documentos&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-cl" target="ctx-sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e6" value="Envia orçamentos, convites, pedidos&lt;br&gt;de compra, relatórios e avisos&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[SMTP]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.2909090909090909;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-sys" target="ctx-em"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e7" value="Entrega o orçamento e&lt;br&gt;o link do portal&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[E-mail]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.25;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-em" target="ctx-cl"><mxGeometry relative="1" x="-0.2" as="geometry"><Array as="points"><mxPoint x="800" y="1130"/><mxPoint x="170" y="1130"/></Array></mxGeometry></mxCell><mxCell id="ctx-e8" value="Entrega pedidos de compra&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[E-mail]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;entryX=0.5;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-em" target="ctx-fo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="856" y="1160"/><mxPoint x="1920" y="1160"/></Array></mxGeometry></mxCell><mxCell id="ctx-e9" value="Consulta endereço pelo CEP&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS/JSON]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.6272727272727273;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-sys" target="ctx-cep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e10" value="Confirma pagamentos Pix (simulação no MVP; PSP real: To be implemented)&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Webhook HTTPS assinado]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.9636363636363636;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="ctx-pix" target="ctx-sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e11" value="Envia o link do orçamento&lt;br&gt;(link wa.me gerado pelo sistema)&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[WhatsApp]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-at" target="ctx-wa"><mxGeometry relative="1" x="-0.15" as="geometry"><Array as="points"><mxPoint x="30" y="210"/><mxPoint x="30" y="975"/></Array></mxGeometry></mxCell><mxCell id="ctx-e12" value="Entrega a&lt;br&gt;mensagem" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.15384615384615385;exitY=0;entryX=0.7;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-wa" target="ctx-cl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e13" value="Enviará mensagens&lt;br&gt;automáticas&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[API WhatsApp]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.045454545454545456;exitY=1;entryX=1;entryY=0.5;dashed=1;dashPattern=6 4;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-sys" target="ctx-wa"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="975"/></Array></mxGeometry></mxCell><mxCell id="ctx-e14" value="Emitirá notas&lt;br&gt;fiscais" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=0.5;dashed=1;dashPattern=6 4;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-sys" target="ctx-fis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-e15" value="Encaminhará&lt;br&gt;pagamentos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;entryX=0;entryY=0.5;dashed=1;dashPattern=6 4;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-sys" target="ctx-card"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctx-lg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="2060" y="120" width="470" height="532" as="geometry"/></mxCell><mxCell id="ctx-lgt" value="&lt;b&gt;Legenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2072" y="128" width="300" height="24" as="geometry"/></mxCell><mxCell id="ctx-lgs0" value="&lt;b&gt;Pessoa&lt;/b&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=6;spacingRight=6;fontSize=10;spacingTop=30;" vertex="1" parent="1"><mxGeometry x="2076" y="156" width="70" height="66" as="geometry"/></mxCell><mxCell id="ctx-lgd0" value="Pessoa" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="156" width="320" height="66" as="geometry"/></mxCell><mxCell id="ctx-lgs1" value="&lt;b&gt;Sistema&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=11;spacing=8;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2076" y="234" width="110" height="44" as="geometry"/></mxCell><mxCell id="ctx-lgd1" value="Sistema de software (o sistema em foco)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="234" width="320" height="44" as="geometry"/></mxCell><mxCell id="ctx-lgs2" value="&lt;b&gt;Externo&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;spacing=8;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2076" y="290" width="110" height="44" as="geometry"/></mxCell><mxCell id="ctx-lgd2" value="Sistema externo (fora do controle do grupo)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="290" width="320" height="44" as="geometry"/></mxCell><mxCell id="ctx-lgs3" value="&lt;b&gt;To be implemented&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#8C8496;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#4A4A4A;fontSize=11;spacing=8;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2076" y="346" width="110" height="44" as="geometry"/></mxCell><mxCell id="ctx-lgd3" value="To be implemented: planejado, ainda não implementado. Relações com ele usam linha tracejada" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="346" width="320" height="44" as="geometry"/></mxCell><mxCell id="ctx-lgb" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;strokeWidth=1.5;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=6;fontColor=#222222;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2076" y="402" width="110" height="40" as="geometry"/></mxCell><mxCell id="ctx-lgbd" value="Limite tracejado escuro: fronteira do sistema ou do container em foco" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="402" width="320" height="40" as="geometry"/></mxCell><mxCell id="ctx-lgline" value="" style="endArrow=blockThin;endFill=1;endSize=9;html=1;strokeColor=#6B6B6B;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2076" y="468" as="sourcePoint"/><mxPoint x="2186" y="468" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ctx-lgad" value="Seta: relação de mão única, rotulada com o que acontece e, entre colchetes, a tecnologia ou protocolo" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="454" width="320" height="30" as="geometry"/></mxCell><mxCell id="ctx-lgsig" value="&lt;b&gt;Siglas:&lt;/b&gt; O.S. = Ordem de Serviço · API = interface de programação · SPA = aplicação de página única no navegador · REST/JSON = estilo e formato das requisições HTTP · JWT = token de autenticação · SMTP = protocolo de envio de e-mail · CEP = código postal · Pix = pagamento instantâneo do Banco Central · PSP = provedor de serviço de pagamento · NF-e/NFS-e = notas fiscais eletrônicas · 2FA = verificação em duas etapas · LGPD = Lei Geral de Proteção de Dados · EF Core = Entity Framework Core (acesso ao banco) · DTO = objeto de transferência de dados" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2076" y="496" width="444" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ctn" name="2. Containers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1750" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ctn-title" value="&lt;b&gt;[Diagrama de Containers] Sistema Integrado de Atendimento e Execução de Serviços (mecanicaOS)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;C4 · Nível 2 · Blocos executáveis do sistema, suas tecnologias e como se comunicam (ambiente orquestrado por docker-compose)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1800" height="60" as="geometry"/></mxCell><mxCell id="ctn-at" value="&lt;b style=&quot;font-size:12px&quot;&gt;Atendente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Recepção: atende o cliente, abre a O.S. e monta o orçamento" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctn-me" value="&lt;b style=&quot;font-size:12px&quot;&gt;Mecânico&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Diagnostica o veículo e executa os serviços" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="780" y="120" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctn-ge" value="&lt;b style=&quot;font-size:12px&quot;&gt;Gerente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Opera a oficina, acompanha resultados e aprova descontos" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctn-ad" value="&lt;b style=&quot;font-size:12px&quot;&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Administra equipe, configurações e segurança; pode tudo" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1380" y="120" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctn-cl" value="&lt;b style=&quot;font-size:12px&quot;&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Pessoa física ou jurídica (CPF/CNPJ) dona do veículo; não faz login" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="120" y="465" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctn-fo" value="&lt;b style=&quot;font-size:12px&quot;&gt;Fornecedor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Empresa que vende peças e insumos à oficina" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1760" y="1330" width="200" height="180" as="geometry"/></mxCell><mxCell id="ctn-bnd" value="&lt;b&gt;Sistema Integrado de Atendimento e Execução de Serviços (mecanicaOS)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema de software]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;strokeWidth=1.5;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=6;fontColor=#222222;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="430" width="1180" height="840" as="geometry"/></mxCell><mxCell id="ctn-web" value="&lt;b style=&quot;font-size:12px&quot;&gt;Aplicação Web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: Angular 22 (SPA) · nginx · Docker]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Telas da equipe (recepção, modo mecânico, quadro de O.S., estoque, painel, financeiro, relatórios, configurações), portal do cliente e verificação de documentos. O nginx entrega a SPA e faz proxy de /api para a API" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="470" width="1100" height="170" as="geometry"/></mxCell><mxCell id="ctn-api" value="&lt;b style=&quot;font-size:12px&quot;&gt;API Monolítica&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: ASP.NET Core · .NET 10 · Docker]&lt;/span&gt;&lt;br&gt;&lt;br&gt;API REST em camadas (Api, Application, Domain, Infrastructure) com rotas /api/admin (JWT por perfil), /api/public (portal e consulta, sem login) e /api/auth. Aplica as regras de negócio, publica eventos em tempo real (SignalR), documenta via Swagger e roda tarefas em segundo plano (Outbox, automações e relatórios agendados)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="760" width="1100" height="200" as="geometry"/></mxCell><mxCell id="ctn-db" value="&lt;b style=&quot;font-size:12px&quot;&gt;Banco de Dados&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: SQL Server 2022 · Docker]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Dados de toda a oficina e eventos pendentes (Outbox). Schema criado por migrations" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1280" y="1060" width="300" height="170" as="geometry"/></mxCell><mxCell id="ctn-wa" value="&lt;b style=&quot;font-size:12px&quot;&gt;WhatsApp&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Aplicativo de mensagens" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="180" y="1350" width="260" height="140" as="geometry"/></mxCell><mxCell id="ctn-em" value="&lt;b style=&quot;font-size:12px&quot;&gt;Servidor de E-mail&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Servidor SMTP" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="1350" width="280" height="140" as="geometry"/></mxCell><mxCell id="ctn-cep" value="&lt;b style=&quot;font-size:12px&quot;&gt;ViaCEP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Consulta de endereço por CEP" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="860" y="1350" width="240" height="140" as="geometry"/></mxCell><mxCell id="ctn-fis" value="&lt;b style=&quot;font-size:12px&quot;&gt;Emissão Fiscal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;NFS-e, NF-e e NFC-e&lt;br&gt;&lt;br&gt;&lt;b&gt;« To be implemented »&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#8C8496;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#4A4A4A;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1140" y="1350" width="260" height="140" as="geometry"/></mxCell><mxCell id="ctn-pix" value="&lt;b style=&quot;font-size:12px&quot;&gt;Instituição de Pagamento (Pix)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Banco ou PSP que recebe o Pix. No MVP a confirmação é simulada (contrato próprio { txId } + HMAC); integração com PSP real: « To be implemented »" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1740" y="690" width="280" height="140" as="geometry"/></mxCell><mxCell id="ctn-card" value="&lt;b style=&quot;font-size:12px&quot;&gt;Gateway de Cartão&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Pagamentos com cartão&lt;br&gt;&lt;br&gt;&lt;b&gt;« To be implemented »&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#8C8496;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#4A4A4A;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1740" y="900" width="280" height="140" as="geometry"/></mxCell><mxCell id="ctn-e1" value="Usa recepção, O.S.,&lt;br&gt;orçamentos e documentos&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;entryX=0.09090909090909091;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctn-at" target="ctn-web"><mxGeometry relative="1" x="-0.4" as="geometry"></mxGeometry></mxCell><mxCell id="ctn-e2" value="Usa o modo mecânico&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;entryX=0.36363636363636365;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctn-me" target="ctn-web"><mxGeometry relative="1" x="0.4" as="geometry"></mxGeometry></mxCell><mxCell id="ctn-e3" value="Usa painel, financeiro,&lt;br&gt;relatórios, estoque e compras&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;entryX=0.6363636363636364;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctn-ge" target="ctn-web"><mxGeometry relative="1" x="-0.4" as="geometry"></mxGeometry></mxCell><mxCell id="ctn-e4" value="Administra equipe, configurações&lt;br&gt;e automações&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;entryX=0.9090909090909091;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctn-ad" target="ctn-web"><mxGeometry relative="1" x="0.4" as="geometry"></mxGeometry></mxCell><mxCell id="ctn-e5" value="Abre o portal do cliente,&lt;br&gt;consulta a O.S. e&lt;br&gt;verifica documentos&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctn-cl" target="ctn-web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctn-e6" value="Chama a API REST&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS/JSON + JWT Bearer; renovação por cookie HttpOnly]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.3;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctn-web" target="ctn-api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctn-e7" value="Envia mudanças em tempo real&lt;br&gt;(quadro de O.S. e notificações)&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[SignalR / WebSocket]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;entryX=0.7;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctn-api" target="ctn-web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctn-e8" value="Lê e grava dados&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[EF Core · TCP 1433]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.8636363636363636;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctn-api" target="ctn-db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctn-e9" value="Envia e-mails&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[SMTP]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.16363636363636364;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctn-api" target="ctn-em"><mxGeometry relative="