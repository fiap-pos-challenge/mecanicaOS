="ctn-api" target="ctn-card"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctn-e14" value="Entrega o orçamento e o link do portal&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[E-mail]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.2;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctn-em" target="ctn-cl"><mxGeometry relative="1" x="-0.2" as="geometry"><Array as="points"><mxPoint x="660" y="1560"/><mxPoint x="160" y="1560"/></Array></mxGeometry></mxCell><mxCell id="ctn-e15" value="Entrega pedidos de compra&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[E-mail]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;entryX=0.5;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctn-em" target="ctn-fo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="1590"/><mxPoint x="1860" y="1590"/></Array></mxGeometry></mxCell><mxCell id="ctn-e16" value="Envia o link do orçamento&lt;br&gt;(link wa.me gerado pelo sistema)&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[WhatsApp]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctn-at" target="ctn-wa"><mxGeometry relative="1" x="-0.15" as="geometry"><Array as="points"><mxPoint x="30" y="210"/><mxPoint x="30" y="1420"/></Array></mxGeometry></mxCell><mxCell id="ctn-e17" value="Entrega a&lt;br&gt;mensagem" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.3076923076923077;exitY=0;entryX=0.7;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctn-wa" target="ctn-cl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctn-e18" value="Enviará mensagens&lt;br&gt;automáticas&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[API WhatsApp]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.7;entryX=0.6923076923076923;entryY=0;dashed=1;dashPattern=6 4;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctn-api" target="ctn-wa"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="900"/></Array></mxGeometry></mxCell><mxCell id="ctn-lg" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="2060" y="120" width="470" height="650" as="geometry"/></mxCell><mxCell id="ctn-seed" value="&lt;b style=&quot;font-size:12px&quot;&gt;Carga de demonstração&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: Node.js 22 · Docker (roda uma vez)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Preenche o banco vazio pela API com equipe, clientes, catálogo, estoque e O.S. em todas as etapas; confirma Pix pelo webhook simulado" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="2072" y="700" width="300" height="150" as="geometry"/></mxCell><mxCell id="ctn-sonar" value="&lt;b style=&quot;font-size:12px&quot;&gt;SonarQube&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container de apoio: SonarQube Community · Docker (profile quality)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Fora do ambiente da aplicação. Analisa qualidade, cobertura e vulnerabilidades do backend e do frontend (scripts/sonar/run-analysis.mjs)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#9E9E9E;fontColor=#1F1F1F;fontSize=11;spacing=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="2072" y="900" width="300" height="160" as="geometry"/></mxCell><mxCell id="ctn-e19" value="Carrega dados de demonstração&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[HTTPS/JSON]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=9;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="ctn-seed" target="ctn-api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ctn-lgt" value="&lt;b&gt;Legenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2072" y="128" width="300" height="24" as="geometry"/></mxCell><mxCell id="ctn-lgs0" value="&lt;b&gt;Pessoa&lt;/b&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=bottom;spacingBottom=14;spacingLeft=6;spacingRight=6;fontSize=10;spacingTop=30;" vertex="1" parent="1"><mxGeometry x="2076" y="156" width="70" height="66" as="geometry"/></mxCell><mxCell id="ctn-lgd0" value="Pessoa" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="156" width="320" height="66" as="geometry"/></mxCell><mxCell id="ctn-lgs1" value="&lt;b&gt;Sistema&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=11;spacing=8;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2076" y="234" width="110" height="44" as="geometry"/></mxCell><mxCell id="ctn-lgd1" value="Sistema de software (o sistema em foco)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="234" width="320" height="44" as="geometry"/></mxCell><mxCell id="ctn-lgs2" value="&lt;b&gt;Externo&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;spacing=8;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2076" y="290" width="110" height="44" as="geometry"/></mxCell><mxCell id="ctn-lgd2" value="Sistema externo (fora do controle do grupo)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="290" width="320" height="44" as="geometry"/></mxCell><mxCell id="ctn-lgs3" value="&lt;b&gt;Container&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;spacing=8;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2076" y="346" width="110" height="44" as="geometry"/></mxCell><mxCell id="ctn-lgd3" value="Container (aplicação ou serviço executável)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="346" width="320" height="44" as="geometry"/></mxCell><mxCell id="ctn-lgs4" value="&lt;b&gt;Banco&lt;/b&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;spacing=8;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2076" y="402" width="110" height="50" as="geometry"/></mxCell><mxCell id="ctn-lgd4" value="Container de banco de dados" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="402" width="320" height="50" as="geometry"/></mxCell><mxCell id="ctn-lgs5" value="&lt;b&gt;To be implemented&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#8C8496;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#4A4A4A;fontSize=11;spacing=8;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2076" y="464" width="110" height="44" as="geometry"/></mxCell><mxCell id="ctn-lgd5" value="To be implemented: planejado, ainda não implementado. Relações com ele usam linha tracejada" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="464" width="320" height="44" as="geometry"/></mxCell><mxCell id="ctn-lgb" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;strokeWidth=1.5;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=6;fontColor=#222222;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2076" y="520" width="110" height="40" as="geometry"/></mxCell><mxCell id="ctn-lgbd" value="Limite tracejado escuro: fronteira do sistema ou do container em foco" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="520" width="320" height="40" as="geometry"/></mxCell><mxCell id="ctn-lgline" value="" style="endArrow=blockThin;endFill=1;endSize=9;html=1;strokeColor=#6B6B6B;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2076" y="586" as="sourcePoint"/><mxPoint x="2186" y="586" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ctn-lgad" value="Seta: relação de mão única, rotulada com o que acontece e, entre colchetes, a tecnologia ou protocolo" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2200" y="572" width="320" height="30" as="geometry"/></mxCell><mxCell id="ctn-lgsig" value="&lt;b&gt;Siglas:&lt;/b&gt; O.S. = Ordem de Serviço · API = interface de programação · SPA = aplicação de página única no navegador · REST/JSON = estilo e formato das requisições HTTP · JWT = token de autenticação · SMTP = protocolo de envio de e-mail · CEP = código postal · Pix = pagamento instantâneo do Banco Central · PSP = provedor de serviço de pagamento · NF-e/NFS-e = notas fiscais eletrônicas · 2FA = verificação em duas etapas · LGPD = Lei Geral de Proteção de Dados · EF Core = Entity Framework Core (acesso ao banco) · DTO = objeto de transferência de dados" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2076" y="614" width="444" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cmp" name="3. Componentes - API"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="2950" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cmp-title" value="&lt;b&gt;[Diagrama de Componentes] API Monolítica&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;C4 · Nível 3 · Componentes internos do container API Monolítica (Sistema Integrado de Atendimento e Execução de Serviços (mecanicaOS)), organizados por camada&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1800" height="60" as="geometry"/></mxCell><mxCell id="cmp-web" value="&lt;b style=&quot;font-size:12px&quot;&gt;Aplicação Web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Container: Angular 22 (SPA) · nginx]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Telas da equipe e portal do cliente" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="90" width="840" height="170" as="geometry"/></mxCell><mxCell id="cmp-pix" value="&lt;b style=&quot;font-size:12px&quot;&gt;Instituição de Pagamento (Pix)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Banco ou PSP. Confirmação simulada no MVP" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="2380" y="90" width="280" height="140" as="geometry"/></mxCell><mxCell id="cmp-bnd" value="&lt;b&gt;API Monolítica&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: ASP.NET Core · .NET 10]&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;strokeWidth=1.5;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=6;fontColor=#222222;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="310" width="2200" height="1940" as="geometry"/></mxCell><mxCell id="cmp-l1" value="&lt;b&gt;Camada de Apresentação&lt;/b&gt; · projeto Oficina.Api" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#B0B7BF;dashed=1;dashPattern=4 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#4A5560;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="330" width="2160" height="270" as="geometry"/></mxCell><mxCell id="cmp-l2" value="&lt;b&gt;Camada de Aplicação&lt;/b&gt; · projeto Oficina.Application (CQRS)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#B0B7BF;dashed=1;dashPattern=4 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#4A5560;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="620" width="2160" height="480" as="geometry"/></mxCell><mxCell id="cmp-l3" value="&lt;b&gt;Camada de Domínio&lt;/b&gt; · projeto Oficina.Domain (não depende de nenhuma outra camada)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#B0B7BF;dashed=1;dashPattern=4 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#4A5560;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="1120" width="2160" height="350" as="geometry"/></mxCell><mxCell id="cmp-l4" value="&lt;b&gt;Camada de Infraestrutura&lt;/b&gt; · projeto Oficina.Infrastructure" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#B0B7BF;dashed=1;dashPattern=4 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#4A5560;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="1490" width="2160" height="740" as="geometry"/></mxCell><mxCell id="cmp-auth" value="&lt;b style=&quot;font-size:12px&quot;&gt;Autenticação e Sessão&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: JWT Bearer · Policies · Rate Limiter]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Valida o token, aplica a policy de cada perfil, limita tentativas de login e as requisições por IP em todo /api/public (429)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="140" y="355" width="250" height="110" as="geometry"/></mxCell><mxCell id="cmp-err" value="&lt;b style=&quot;font-size:12px&quot;&gt;Tratamento de Erros&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: ProblemDetails]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Respostas de erro com código estável" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="140" y="478" width="250" height="100" as="geometry"/></mxCell><mxCell id="cmp-adm" value="&lt;b style=&quot;font-size:12px&quot;&gt;Controllers Administrativos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: ASP.NET Core Controllers]&lt;/span&gt;&lt;br&gt;&lt;br&gt;/api/admin e /api/auth: clientes, veículos, catálogo, estoque e compras, O.S., orçamentos, documentos, equipe, painel, financeiro, relatórios, automações, filas e configurações" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="380" width="630" height="170" as="geometry"/></mxCell><mxCell id="cmp-rt" value="&lt;b style=&quot;font-size:12px&quot;&gt;Tempo Real&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: ASP.NET Core SignalR Hub]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Mantém conexões WebSocket e envia mudanças do quadro de O.S. e notificações" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1140" y="380" width="300" height="170" as="geometry"/></mxCell><mxCell id="cmp-pub" value="&lt;b style=&quot;font-size:12px&quot;&gt;Controllers Públicos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: ASP.NET Core Controllers]&lt;/span&gt;&lt;br&gt;&lt;br&gt;/api/public: portal do cliente, consulta da O.S., verificação de documentos e webhook Pix" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1470" y="380" width="300" height="170" as="geometry"/></mxCell><mxCell id="cmp-pipe" value="&lt;b style=&quot;font-size:12px&quot;&gt;Pipeline de Casos de Uso&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: MediatR · FluentValidation]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Valida a entrada e registra log de cada command e query" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="140" y="700" width="250" height="130" as="geometry"/></mxCell><mxCell id="cmp-gmod" value="Módulos de casos de uso · Componente: um command ou query por caso de uso (MediatR), com handler e validator" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8A949E;dashed=1;dashPattern=3 3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontColor=#4A5560;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="650" width="1660" height="430" as="geometry"/></mxCell><mxCell id="cmp-m1" value="&lt;b style=&quot;font-size:12px&quot;&gt;Identidade e Equipe&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: casos de uso]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Login, sessões, 2FA, convites, reautenticação, usuários, perfis profissionais e permissões" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="680" width="300" height="170" as="geometry"/></mxCell><mxCell id="cmp-m2" value="&lt;b style=&quot;font-size:12px&quot;&gt;Cadastros e Privacidade&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: casos de uso]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Clientes, veículos (quilometragem, transferência), endereço por CEP, consentimento e revelação de dados com motivo" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="810" y="680" width="300" height="170" as="geometry"/></mxCell><mxCell id="cmp-m3" value="&lt;b style=&quot;font-size:12px&quot;&gt;Catálogo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: casos de uso]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Serviços, peças, insumos, peças usuais, pacotes e histórico de preços" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1140" y="680" width="300" height="170" as="geometry"/></mxCell><mxCell id="cmp-m4" value="&lt;b style=&quot;font-size:12px&quot;&gt;Estoque e Compras&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: casos de uso]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Entradas (manual, código de barras, XML de NF-e), saídas, contagens, sugestões de compra, fornecedores e pedidos" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1470" y="680" width="300" height="170" as="geometry"/></mxCell><mxCell id="cmp-m5" value="&lt;b style=&quot;font-size:12px&quot;&gt;Ordens de Serviço&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: casos de uso]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Abrir, diagnosticar, checklist, fotos, cronômetro, enviar para orçamento, finalizar, entregar, quadro e tempo médio" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1800" y="680" width="300" height="170" as="geometry"/></mxCell><mxCell id="cmp-m6" value="&lt;b style=&quot;font-size:12px&quot;&gt;Orçamentos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: casos de uso]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Rascunho, descontos e aprovação de desconto, envio (WhatsApp, e-mail ou link), aprovação total ou parcial, recusa e nova versão" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="870" width="300" height="170" as="geometry"/></mxCell><mxCell id="cmp-m7" value="&lt;b style=&quot;font-size:12px&quot;&gt;Portal do Cliente e Pagamentos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: casos de uso]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Confirmação de identidade, sessão do portal, resposta ao orçamento, cobrança Pix e confirmação por webhook" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="810" y="870" width="300" height="170" as="geometry"/></mxCell><mxCell id="cmp-m8" value="&lt;b style=&quot;font-size:12px&quot;&gt;Documentos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: casos de uso]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Emite O.S., orçamento e recibo em PDF com código de verificação e confere autenticidade" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1140" y="870" width="300" height="170" as="geometry"/></mxCell><mxCell id="cmp-m9" value="&lt;b style=&quot;font-size:12px&quot;&gt;Gestão&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: casos de uso]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Painel e avisos de atenção, financeiro, relatórios (XLSX/PDF), relatórios agendados e assistente de perguntas" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1470" y="870" width="300" height="170" as="geometry"/></mxCell><mxCell id="cmp-m10" value="&lt;b style=&quot;font-size:12px&quot;&gt;Automações, Notificações e Configurações&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: casos de uso]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Regras de automação, fila de jobs, notificações da equipe, configurações da oficina e auditoria" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1800" y="870" width="300" height="170" as="geometry"/></mxCell><mxCell id="cmp-gdom" value="Agregados de domínio · entidades, value objects, regras e eventos" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8A949E;dashed=1;dashPattern=3 3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontColor=#4A5560;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="1135" width="1270" height="320" as="geometry"/></mxCell><mxCell id="cmp-d1" value="&lt;b style=&quot;font-size:12px&quot;&gt;Identidade e Equipe&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: agregados]&lt;/span&gt;&lt;br&gt;&lt;br&gt;User, sessões, convites, 2FA e reautenticação; perfis profissionais e turnos" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="1165" width="250" height="130" as="geometry"/></mxCell><mxCell id="cmp-d2" value="&lt;b style=&quot;font-size:12px&quot;&gt;Cadastros e Privacidade&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: agregados]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Customer e Vehicle (CPF/CNPJ, placa, quilometragem); acesso a dados sensíveis" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="850" y="1165" width="250" height="130" as="geometry"/></mxCell><mxCell id="cmp-d3" value="&lt;b style=&quot;font-size:12px&quot;&gt;Catálogo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: agregados]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Service, Package e histórico de preços" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="1165" width="250" height="130" as="geometry"/></mxCell><mxCell id="cmp-d4" value="&lt;b style=&quot;font-size:12px&quot;&gt;Estoque e Compras&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: agregados]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Part (peça ou insumo), movimentações, contagens, fornecedores e pedidos de compra" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1510" y="1165" width="250" height="130" as="geometry"/></mxCell><mxCell id="cmp-d5" value="&lt;b style=&quot;font-size:12px&quot;&gt;Ordens de Serviço&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: agregados]&lt;/span&gt;&lt;br&gt;&lt;br&gt;ServiceOrder: status e transições, itens, checklist, cronômetro e histórico; ServiceOrderPhoto (até 12, carregadas sob demanda)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="1310" width="250" height="130" as="geometry"/></mxCell><mxCell id="cmp-d6" value="&lt;b style=&quot;font-size:12px&quot;&gt;Orçamentos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: agregados]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Estimate: versões, descontos e limites (EstimatePricing), plano de pagamento, envio, trava do portal e aprovação total ou parcial" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="850" y="1310" width="250" height="130" as="geometry"/></mxCell><mxCell id="cmp-d7" value="&lt;b style=&quot;font-size:12px&quot;&gt;Portal, Pagamentos e Documentos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: agregados]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Acesso ao portal, cobrança Pix e documentos emitidos" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="1310" width="250" height="130" as="geometry"/></mxCell><mxCell id="cmp-d8" value="&lt;b style=&quot;font-size:12px&quot;&gt;Gestão e Operação&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: agregados]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Configurações, automações, notificações, relatórios salvos e auditoria (BackgroundJob fica na camada de Aplicação)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1510" y="1310" width="250" height="130" as="geometry"/></mxCell><mxCell id="cmp-sec" value="&lt;b style=&quot;font-size:12px&quot;&gt;Segurança&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: JWT · BCrypt · TOTP · Data Protection]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Gera tokens, faz hash de senhas, valida códigos de duas etapas e cifra o segredo do 2FA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="140" y="1560" width="250" height="140" as="geometry"/></mxCell><mxCell id="cmp-qry" value="&lt;b style=&quot;font-size:12px&quot;&gt;Consultas (leitura)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: EF Core · Mapperly]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Projeta DTOs de listas, detalhes, painel e relatórios" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="1560" width="300" height="140" as="geometry"/></mxCell><mxCell id="cmp-per" value="&lt;b style=&quot;font-size:12px&quot;&gt;Persistência e Unidade de Trabalho&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: EF Core (DbContext, repositórios, UnitOfWork)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Carrega e salva agregados numa transação, audita, aplica exclusão lógica e grava eventos no Outbox" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="810" y="1560" width="300" height="140" as="geometry"/></mxCell><mxCell id="cmp-obx" value="&lt;b style=&quot;font-size:12px&quot;&gt;Processador de Outbox&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: .NET BackgroundService]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Depois do commit, entrega aos handlers os eventos de O.S. e orçamento, pagamentos (PaymentConfirmed: recibo e aviso), notificações (NotificationCreated: tempo real e e-mail) e estoque (StockDeducted, StockBelowMinimum), com retentativas" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1140" y="1560" width="300" height="140" as="geometry"/></mxCell><mxCell id="cmp-sch" value="&lt;b style=&quot;font-size:12px&quot;&gt;Agendadores&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: .NET BackgroundServices]&lt;/span&gt;&lt;br&gt;&lt;br&gt;AutomationSweeper (varredura de automações) e ReportScheduler (relatórios agendados)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1470" y="1560" width="300" height="140" as="geometry"/></mxCell><mxCell id="cmp-ginf" value="Integrações" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8A949E;dashed=1;dashPattern=3 3;verticalAlign=top;align=left;spacingLeft=8;spacingTop=0;fontColor=#4A5560;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1785" y="1530" width="330" height="680" as="geometry"/></mxCell><mxCell id="cmp-eml" value="&lt;b style=&quot;font-size:12px&quot;&gt;Envio de E-mail&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: SMTP (System.Net.Mail)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Convites, orçamentos, pedidos de compra, relatórios e notificações" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1800" y="1560" width="300" height="140" as="geometry"/></mxCell><mxCell id="cmp-cepc" value="&lt;b style=&quot;font-size:12px&quot;&gt;Busca de CEP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: HttpClient]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Consulta o endereço pelo CEP" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1800" y="1720" width="300" height="140" as="geometry"/></mxCell><mxCell id="cmp-pixc" value="&lt;b style=&quot;font-size:12px&quot;&gt;Gerador Pix&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: BR Code · QRCoder]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Gera o código copia-e-cola e o QR code da cobrança" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5A9BD8;fontColor=#000000;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1800" y="1880" width="300" height="140" as="geometry"/></mxCell><mxCell id="cmp-wac" value="&lt;b style=&quot;font-size:12px&quot;&gt;Envio de WhatsApp&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Envio automático (automações e aviso de O.S. finalizada). Hoje só registra em log&lt;br&gt;&lt;br&gt;&lt;b&gt;« To be implemented »&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#8C8496;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#4A4A4A;fontSize=11;spacing=8;fontSize=10;" vertex=