strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="156" y="2878" as="sourcePoint"/><mxPoint x="266" y="2878" as="targetPoint"/></mxGeometry></mxCell><mxCell id="cmp-lgad" value="Seta: relação de mão única, rotulada com o que acontece e, entre colchetes, a tecnologia ou protocolo" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="2864" width="320" height="30" as="geometry"/></mxCell><mxCell id="cmp-lgsig" value="&lt;b&gt;Siglas:&lt;/b&gt; O.S. = Ordem de Serviço · API = interface de programação · SPA = aplicação de página única no navegador · REST/JSON = estilo e formato das requisições HTTP · JWT = token de autenticação · SMTP = protocolo de envio de e-mail · CEP = código postal · Pix = pagamento instantâneo do Banco Central · PSP = provedor de serviço de pagamento · NF-e/NFS-e = notas fiscais eletrônicas · 2FA = verificação em duas etapas · LGPD = Lei Geral de Proteção de Dados · EF Core = Entity Framework Core (acesso ao banco) · DTO = objeto de transferência de dados" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="156" y="2906" width="444" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
