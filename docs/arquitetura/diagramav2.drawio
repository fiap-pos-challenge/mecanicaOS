dm2-101" value="Quantidade maior que 0 ?" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="3415.0" width="120" height="110" as="geometry"/></mxCell><mxCell id="adm2-102" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm2-97" target="adm2-101"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm2-103" value="FIM&lt;br&gt;HTTP 400" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;" vertex="1" parent="1"><mxGeometry x="420.0" y="3580.0" width="80" height="80" as="geometry"/></mxCell><mxCell id="adm2-104" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="adm2-101" target="adm2-103"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm2-105" value="Somar quantidade ao saldo" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="570" y="3440.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="adm2-106" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm2-101" target="adm2-105"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm2-107" value="TB_PECAS&lt;br&gt;TB_MOVIMENTACOES" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="3435.0" width="120" height="70" as="geometry"/></mxCell><mxCell id="adm2-108" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm2-105" target="adm2-107"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm2-109" value="FIM" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;" vertex="1" parent="1"><mxGeometry x="930" y="3430.0" width="80" height="80" as="geometry"/></mxCell><mxCell id="adm2-110" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm2-107" target="adm2-109"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Gestão Administrativa - OS, Métricas e Acesso" id="adm3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="adm3-2" value="&lt;b style='font-size:18px'&gt;Gestão Administrativa — Ordens de Serviço, Monitoramento e Acesso&lt;/b&gt;&lt;br&gt;Exclusões são lógicas: o registro some das consultas, mas o histórico das OS é preservado. Rotas /api/admin exigem JWT (401 sem token, 403 perfil não permitido)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1500" height="60" as="geometry"/></mxCell><mxCell id="adm3-3" value="&lt;b style='font-size:14px'&gt;Listar Ordens de Serviço&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;font face='Courier New'&gt;GET /api/admin/ordens-servico?status=&amp;placa=&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;b&gt;Permitido:&lt;/b&gt; Atendente, Mecânico, Admin&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1200" height="40" as="geometry"/></mxCell><mxCell id="adm3-4" value="Consultar OS com filtros" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="220.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="adm3-5" value="Retornar lista paginada" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="230" y="220.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="adm3-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm3-4" target="adm3-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm3-7" value="FIM" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;" vertex="1" parent="1"><mxGeometry x="420" y="210.0" width="80" height="80" as="geometry"/></mxCell><mxCell id="adm3-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm3-5" target="adm3-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm3-9" value="&lt;b style='font-size:14px'&gt;Detalhar Ordem de Serviço&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;font face='Courier New'&gt;GET /api/admin/ordens-servico/{id}&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;b&gt;Permitido:&lt;/b&gt; Atendente, Mecânico, Admin&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1200" height="40" as="geometry"/></mxCell><mxCell id="adm3-10" value="Consultar Ordem de Serviço" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="460.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="adm3-11" value="Existe ?" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="435.0" width="120" height="110" as="geometry"/></mxCell><mxCell id="adm3-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm3-10" target="adm3-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm3-13" value="FIM&lt;br&gt;HTTP 404" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;" vertex="1" parent="1"><mxGeometry x="250.0" y="600.0" width="80" height="80" as="geometry"/></mxCell><mxCell id="adm3-14" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="adm3-11" target="adm3-13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm3-15" value="Retornar OS com itens, orçamento e histórico de status" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="460.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="adm3-16" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm3-11" target="adm3-15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm3-17" value="FIM" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;" vertex="1" parent="1"><mxGeometry x="590" y="450.0" width="80" height="80" as="geometry"/></mxCell><mxCell id="adm3-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm3-15" target="adm3-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm3-19" value="&lt;b style='font-size:14px'&gt;Tempo Médio de Execução&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;font face='Courier New'&gt;GET /api/admin/metricas/tempo-medio-execucao?de=&amp;ate=&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;b&gt;Permitido:&lt;/b&gt; Admin&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1200" height="40" as="geometry"/></mxCell><mxCell id="adm3-20" value="Consultar OS finalizadas no período" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="850.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="adm3-21" value="Calcular média&lt;br&gt;(término − início da execução)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="230" y="850.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="adm3-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm3-20" target="adm3-21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm3-23" value="Retornar tempo médio" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="850.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="adm3-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm3-21" target="adm3-23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm3-25" value="FIM" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;" vertex="1" parent="1"><mxGeometry x="610" y="840.0" width="80" height="80" as="geometry"/></mxCell><mxCell id="adm3-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm3-23" target="adm3-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm3-27" value="&lt;b style='font-size:14px'&gt;Login&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;font face='Courier New'&gt;POST /api/auth/login&lt;/font&gt; &amp;nbsp;·&amp;nbsp; &lt;b&gt;Permitido:&lt;/b&gt; Público&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1200" height="40" as="geometry"/></mxCell><mxCell id="adm3-28" value="Consultar usuário pelo e-mail" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1090.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="adm3-29" value="Existe e senha confere ?" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="1065.0" width="120" height="110" as="geometry"/></mxCell><mxCell id="adm3-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm3-28" target="adm3-29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm3-31" value="FIM&lt;br&gt;HTTP 401" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;" vertex="1" parent="1"><mxGeometry x="250.0" y="1230.0" width="80" height="80" as="geometry"/></mxCell><mxCell id="adm3-32" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="adm3-29" target="adm3-31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm3-33" value="Gerar token JWT&lt;br&gt;com o perfil" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="1090.0" width="140" height="60" as="geometry"/></mxCell><mxCell id="adm3-34" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm3-29" target="adm3-33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adm3-35" value="FIM" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;" vertex="1" parent="1"><mxGeometry x="590" y="1080.0" width="80" height="80" as="geometry"/></mxCell><mxCell id="adm3-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm3-33" target="adm3-35"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Perfis e Permissões" id="perm"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="perm-2" value="&lt;b style='font-size:18px'&gt;Perfis e permissões&lt;/b&gt;&lt;br&gt;Rotas &lt;font face='Courier New'&gt;/api/admin/**&lt;/font&gt; exigem token JWT (obtido em &lt;font face='Courier New'&gt;POST /api/auth/login&lt;/font&gt;). Sem token ou token inválido → &lt;b&gt;HTTP 401&lt;/b&gt;. Perfil sem permissão para a operação → &lt;b&gt;HTTP 403&lt;/b&gt;.&lt;br&gt;O cliente não faz login: acompanha a OS pelo número + CPF/CNPJ e responde o orçamento pelo link (token) recebido." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1500" height="60" as="geometry"/></mxCell><mxCell id="perm-3" value="&lt;table style='border-collapse:collapse;font-size:12px;width:100%'&gt;&lt;tr style='background:#eeeeee'&gt;&lt;th style='border:1px solid #999;padding:6px 10px;text-align:left'&gt;Operação&lt;/th&gt;&lt;th style='border:1px solid #999;padding:6px 10px;'&gt;Admin&lt;/th&gt;&lt;th style='border:1px solid #999;padding:6px 10px;'&gt;Atendente&lt;/th&gt;&lt;th style='border:1px solid #999;padding:6px 10px;'&gt;Mecânico&lt;/th&gt;&lt;th style='border:1px solid #999;padding:6px 10px;'&gt;Cliente&lt;/th&gt;&lt;/tr&gt;&lt;tr style='background:#f7f7f7'&gt;&lt;td colspan='5' style='border:1px solid #999;padding:6px 10px;'&gt;&lt;b&gt;Gestão de OS&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:6px 10px;'&gt;Abrir OS&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:6px 10px;'&gt;Iniciar diagnóstico&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:6px 10px;'&gt;Incluir serviços e peças na OS&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:6px 10px;'&gt;Enviar orçamento&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:6px 10px;'&gt;Aprovar / reprovar orçamento&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓ (presencial)&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓ (link)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:6px 10px;'&gt;Finalizar OS&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:6px 10px;'&gt;Entregar veículo&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:6px 10px;'&gt;Acompanhar OS&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓ (nº OS + documento)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:6px 10px;'&gt;Listar / detalhar OS&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;/tr&gt;&