xt-align:center'&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:6px 10px;'&gt;Cadastrar / atualizar / excluir serviços e peças&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:6px 10px;'&gt;Entrada de estoque&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #999;padding:6px 10px;'&gt;Tempo médio de execução&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✓&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;td style='border:1px solid #999;padding:6px 10px;text-align:center'&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="900" height="640" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>