t;ou admin presencial)&lt;br&gt;&lt;b&gt;baixa estoque na mesma transação&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-4" target="p3-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-11" value="POST /{id}/finalizar&lt;br&gt;(registra tempo, notifica)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-5" target="p3-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-12" value="POST /{id}/entregar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-6" target="p3-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-13" value="rejeitar (motivo)&lt;br&gt;volta para revisão" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="p3-4" target="p3-3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="715" y="440"/><mxPoint x="425" y="440"/></Array></mxGeometry></mxCell><mxCell id="p3-14" value="reparo adicional: incluir serviços/peças&lt;br&gt;+ POST /{id}/orcamento/enviar (complementar)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#6c8ebf;fontColor=#6c8ebf;dashed=1;" edge="1" parent="1" source="p3-5" target="p3-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1005" y="200"/><mxPoint x="715" y="200"/></Array></mxGeometry></mxCell><mxCell id="p3-15" value="rejeitar com encerrar=true&lt;br&gt;(cliente desistiu, veículo devolvido)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=1