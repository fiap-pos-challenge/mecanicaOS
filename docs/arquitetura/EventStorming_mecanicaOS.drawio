="1"><mxGeometry x="2050" y="355" width="170" height="140" as="geometry"/></mxCell><mxCell id="es2-n78" value="&lt;b style=&quot;font-size:13px&quot;&gt;Cobrança&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF9B1;" vertex="1" parent="1"><mxGeometry x="2050" y="515" width="170" height="120" as="geometry"/></mxCell><mxCell id="es2-n79" value="&lt;b style=&quot;font-size:13px&quot;&gt;Pagamento confirmado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:monospace&quot;&gt;PaymentConfirmed&lt;/span&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FFA930;" vertex="1" parent="1"><mxGeometry x="2050" y="655" width="170" height="140" as="geometry"/></mxCell><mxCell id="es2-n80" value="&lt;b style=&quot;font-size:13px&quot;&gt;Quando o pagamento é confirmado: emitir recibo, avisar a equipe e disparar automações&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#D7B5E8;" vertex="1" parent="1"><mxGeometry x="2050" y="815" width="170" height="170" as="geometry"/></mxCell><mxCell id="es2-n81" value="&lt;b style=&quot;font-size:13px&quot;&gt;Confirmação simulada: nenhum banco real chama este webhook&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FF8A80;fontColor=#3B0A0A;" vertex="1" parent="1"><mxGeometry x="2050" y="1005" width="170" height="125" as="geometry"/></mxCell><mxCell id="es2-n82" value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#7A5A8C;strokeWidth=1.5;" edge="1" parent="1" source="es2-n79" target="es2-n80"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es2-n83" value="&lt;b&gt;Política&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FEF445;" vertex="1" parent="1"><mxGeometry x="2260" y="260" width="150" height="70" as="geometry"/></mxCell><mxCell id="es2-n84" value="&lt;b style=&quot;font-size:13px&quot;&gt;Emitir recibo&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#6CD8FA;" vertex="1" parent="1"><mxGeometry x="2250" y="355" width="170" height="140" as="geometry"/></mxCell><mxCell id="es2-n85" value="&lt;b style=&quot;font-size:13px&quot;&gt;Documento emitido&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF9B1;" vertex="1" parent="1"><mxGeometry x="2250" y="515" width="170" height="120" as="geometry"/></mxCell><mxCell id="es2-n86" value="&lt;b style=&quot;font-size:13px&quot;&gt;Recibo emitido&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FFA930;" vertex="1" parent="1"><mxGeometry x="2250" y="655" width="170" height="140" as="geometry"/></mxCell><mxCell id="es2-n87" value="&lt;b style=&quot;font-size:13px&quot;&gt;Verificação pública do documento /v/{código}&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#A6DC73;" vertex="1" parent="1"><mxGeometry x="2250" y="1005" width="170" height="125" as="geometry"/></mxCell><mxCell id="es2-n88" value="&lt;b&gt;Atendente&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FEF445;" vertex="1" parent="1"><mxGeometry x="2460" y="260" width="150" height="70" as="geometry"/></mxCell><mxCell id="es2-n89" value="&lt;b style=&quot;font-size:13px&quot;&gt;Entregar veículo&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#6CD8FA;" vertex="1" parent="1"><mxGeometry x="2450" y="355" width="170" height="140" as="geometry"/></mxCell><mxCell id="es2-n90" value="&lt;b style=&quot;font-size:13px&quot;&gt;Ordem de Serviço&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF9B1;" vertex="1" parent="1"><mxGeometry x="2450" y="515" width="170" height="120" as="geometry"/></mxCell><mxCell id="es2-n91" value="&lt;b style=&quot;font-size:13px&quot;&gt;Veículo entregue&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px;color:#4A4A4A&quot;&gt;status Entregue · O.S. encerrada&lt;/i&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FFA930;" vertex="1" parent="1"><mxGeometry x="2450" y="655" width="170" height="140" as="geometry"/></mxCell><mxCell id="es2-n92" value="&lt;b style=&quot;font-size:13px&quot;&gt;Sempre que a O.S. é entregue: disparar automações de pós-venda&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#D7B5E8;" vertex="1" parent="1"><mxGeometry x="2450" y="815" width="170" height="170" as="geometry"/></mxCell><mxCell id="es2-n93" value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#7A5A8C;strokeWidth=1.5;" edge="1" parent="1" source="es2-n91" target="es2-n92"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es2-n94" value="Cada mudança de status também gera ServiceOrderStatusChanged, que atualiza o quadro em tempo real e notifica a equipe (ver Event Storming 1)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1445" width="2630" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="es3" name="Event Storming 3 - Peças e Insumos"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2710" pageHeight="1510" background="#FAFAF7" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="es3-n1" value="&lt;b&gt;Event Storming 3 · Gestão de Peças e Insumos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#555&quot;&gt;Cadastro, entradas e saídas, baixa pelas Ordens de Serviço, reposição e inventário.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2630" height="70" as="geometry"/></mxCell><mxCell id="es3-n2" value="&lt;b&gt;Legenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="90" height="60" as="geometry"/></mxCell><mxCell id="es3-n3" value="&lt;b style=&quot;font-size:11px&quot;&gt;Ator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;quem dispara&lt;/span&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FEF445;spacing=4;" vertex="1" parent="1"><mxGeometry x="140" y="105" width="140" height="70" as="geometry"/></mxCell><mxCell id="es3-n4" value="&lt;b style=&quot;font-size:11px&quot;&gt;Comando&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;intenção / ação&lt;/span&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColo