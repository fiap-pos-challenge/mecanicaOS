ll><mxCell id="es3-n82" value="&lt;b style=&quot;font-size:13px&quot;&gt;Inventário e Peça&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF9B1;" vertex="1" parent="1"><mxGeometry x="2450" y="515" width="170" height="120" as="geometry"/></mxCell><mxCell id="es3-n83" value="&lt;b style=&quot;font-size:13px&quot;&gt;Diferenças ajustadas no estoque&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FFA930;" vertex="1" parent="1"><mxGeometry x="2450" y="655" width="170" height="140" as="geometry"/></mxCell><mxCell id="es3-n84" value="&lt;b style=&quot;font-size:13px&quot;&gt;Regra: só Gerente ou Administrador aprova diferenças de contagem&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#EAD9F2;" vertex="1" parent="1"><mxGeometry x="2450" y="815" width="170" height="170" as="geometry"/></mxCell><mxCell id="es3-n85" value="&lt;b style=&quot;font-size:13px&quot;&gt;Visão geral do estoque&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#A6DC73;" vertex="1" parent="1"><mxGeometry x="2450" y="1005" width="170" height="125" as="geometry"/></mxCell><mxCell id="es3-n86" value="A correspondência de cada post-it com o código (comandos, agregados, eventos de domínio e políticas) está na tabela de rastreabilidade." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1445" width="2630" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
