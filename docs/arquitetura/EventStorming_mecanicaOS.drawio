t;Peça ou insumo&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF9B1;" vertex="1" parent="1"><mxGeometry x="1450" y="515" width="170" height="120" as="geometry"/></mxCell><mxCell id="es3-n56" value="&lt;b style=&quot;font-size:13px&quot;&gt;Estoque baixado / vem da aprovação do orçamento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:monospace&quot;&gt;StockDeducted&lt;/span&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FFA930;" vertex="1" parent="1"><mxGeometry x="1450" y="655" width="170" height="140" as="geometry"/></mxCell><mxCell id="es3-n57" value="&lt;b style=&quot;font-size:13px&quot;&gt;Movimentações da peça&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#A6DC73;" vertex="1" parent="1"><mxGeometry x="1450" y="1005" width="170" height="125" as="geometry"/></mxCell><mxCell id="es3-n58" value="&lt;b&gt;Verificação periódica&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FEF445;" vertex="1" parent="1"><mxGeometry x="1660" y="260" width="150" height="70" as="geometry"/></mxCell><mxCell id="es3-n59" value="&lt;b style=&quot;font-size:13px&quot;&gt;Verificar estoque mínimo&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#6CD8FA;" vertex="1" parent="1"><mxGeometry x="1650" y="355" width="170" height="140" as="geometry"/></mxCell><mxCell id="es3-n60" value="&lt;b style=&quot;font-size:13px&quot;&gt;Peça ou insumo&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF9B1;" vertex="1" parent="1"><mxGeometry x="1650" y="515" width="170" height="120" as="geometry"/></mxCell><mxCell id="es3-n61" value="&lt;b style=&quot;font-size:13px&quot;&gt;Estoque abaixo do mínimo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:monospace&quot;&gt;StockBelowMinimum&lt;/span&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FFA930;" vertex="1" parent="1"><mxGeometry x="1650" y="655" width="170" height="140" as="geometry"/></mxCell><mxCell id="es3-n62" value="&lt;b style=&quot;font-size:13px&quot;&gt;Quando o estoque fica abaixo do mínimo: sugerir compra, avisar no painel e disparar automações (ex.: criar pedido)&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#D7B5E8;" vertex="1" parent="1"><mxGeometry x="1650" y="815" width="170" height="170" as="geometry"/></mxCell><mxCell id="es3-n63" value="&lt;b style=&quot;font-size:13px&quot;&gt;Sugestões de compra&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#A6DC73;" vertex="1" parent="1"><mxGeometry x="1650" y="1005" width="170" height="125" as="geometry"/></mxCell><mxCell id="es3-n64" value="&lt;b style=&quot;font-size:13px&quot;&gt;Avisos de atenção no painel&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#A6DC73;" vertex="1" parent="1"><mxGeometry x="1650" y="1140" width="170" height="125" as="geometry"/></mxCell><mxCell id="es3-n65" value="&lt;b style=&quot;font-size:13px&quot;&gt;Sempre que a baixa ou a saída cruza o mínimo: agendar a reposição e avisar a equipe (a verificação periódica fica como rede de segurança)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:monospace&quot;&gt;OnStockBelowMinimum&lt;/span&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#D7B5E8;" vertex="1" parent="1"><mxGeometry x="1650" y="1275" width="170" height="125" as="geometry"/></mxCell><mxCell id="es3-n66" value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#7A5A8C;strokeWidth=1.5;" edge="1" parent="1" source="es3-n61" target="es3-n62"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es3-n67" value="&lt;b&gt;Gerente ou Administrador&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FEF445;" vertex="1" parent="1"><mxGeometry x="1860" y="260" width="150" height="70" as="geometry"/></mxCell><mxCell id="es3-n68" value="&lt;b style=&quot;font-size:13px&quot;&gt;Criar pedido de compra&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#6CD8FA;" vertex="1" parent="1"><mxGeometry x="1850" y="355" width="170" height="140" as="geometry"/></mxCell><mxCell id="es3-n69" value="&lt;b style=&quot;font-size:13px&quot;&gt;Pedido de compra&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF9B1;" vertex="1" parent="1"><mxGeometry x="1850" y="515" width="170" height="120" as="geometry"/></mxCell><mxCell id="es3-n70" value="&lt;b style=&quot;font-size:13px&quot;&gt;Pedido de compra criado&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FFA930;" vertex="1" parent="1">