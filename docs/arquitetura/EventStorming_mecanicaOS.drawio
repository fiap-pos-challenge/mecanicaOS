<mxfile host="app.diagrams.net" type="device"><diagram id="es1" name="Event Storming 1 - Criação da O.S."><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2510" pageHeight="1510" background="#FAFAF7" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="es1-n1" value="&lt;b&gt;Event Storming 1 · Criação da Ordem de Serviço&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#555&quot;&gt;Da chegada do cliente até o envio do orçamento. A correspondência de cada post-it com o código está na tabela de rastreabilidade.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2430" height="70" as="geometry"/></mxCell><mxCell id="es1-n2" value="&lt;b&gt;Legenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="90" height="60" as="geometry"/></mxCell><mxCell id="es1-n3" value="&lt;b style=&quot;font-size:11px&quot;&gt;Ator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;quem dispara&lt;/span&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#FEF445;spacing=4;" vertex="1" parent="1"><mxGeometry x="140" y="105" width="140" height="70" as="geometry"/></mxCell><mxCell id="es1-n4" value="&lt;b style=&quot;font-size:11px&quot;&gt;Comando&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;intenção / ação&lt;/span&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;shadow=1;rounded=0;fontColor=#1F1F1F;fontSize=12;align=center;verticalAlign=middle;spacing=8;fillColor=#6CD8FA;spacing=4;" vertex="1" parent="1"><mxGeometry x="290" y="105" width="140" height="70" as="geometry"/></mxCell><mxCell id="es1-n5" value="&lt;b st