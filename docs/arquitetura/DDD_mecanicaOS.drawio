<mxfile host="app.diagrams.net" type="device"><diagram id="sub" name="1. Subdomínios"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" background="#FAFAF7" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sub-1" value="&lt;b style=&quot;font-size:24px&quot;&gt;Subdomínios · mecanicaOS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;Classificação da Aula 01 (Principal, Suporte e Genérico). Cada bloco aponta a pasta do código e o motivo da classificação.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2120" height="80" as="geometry"/></mxCell><mxCell id="sub-2" value="&lt;b&gt;Principal&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="660" height="920" as="geometry"/></mxCell><mxCell id="sub-3" value="&lt;b style=&quot;font-size:15px&quot;&gt;Ordens de Serviço&lt;/b&gt;&lt;br&gt;&lt;br&gt;Abrir, diagnosticar, executar, finalizar e entregar com status rastreável. É o que diferencia a oficina e resolve a dor central do enunciado.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:11px&quot;&gt;Domain/ServiceOrders&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="620" height="190" as="geometry"/></mxCell><mxCell id="sub-4" value="&lt;b style=&quot;font-size:15px&quot;&gt;Orçamentos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Montar, enviar e decidir o orçamento (total, parcial ou recusa) com baixa atômica no estoque.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:11px&quot;&gt;Domain/Quotes&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="620" height="190" as="geometry"/></mxCell><mxCell id="sub-5" value="&lt;b&gt;Suporte&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="740" y="120" width="660" height="920" as="geometry"/></mxCell><mxCell id="sub-6" value="&lt;b style=&quot;font-size:15px&quot;&gt;Cadastros&lt;/b&gt;&lt;br&gt;&lt;br&gt;Clientes (CPF/CNPJ) e veículos (placa). Necessários para a O.S., sem diferencial próprio.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:11px&quot;&gt;Domain/Customers · Privacy&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="760" y="170" width="620" height="190" as="geometry"/></mxCell><mxCell id="sub-7" value="&lt;b style=&quot;font-size:15px&quot;&gt;Catálogo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Serviços, peças, insumos e pacotes com preço e histórico.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:11px&quot;&gt;Domain/Catalog&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="760" y="380" width="620" height="190" as="geometry"/></mxCell><mxCell id="sub-8" value="&lt;b style=&quot;font-size:15px&quot;&gt;Estoque e Compras&lt;/b&gt;&lt;br&gt;&lt;br&gt;Saldo, baixa, reposição, NF-e, inventário e pedidos de compra.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:11px&quot;&gt;Domain/Inventory&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="760" y="590" width="620" height="190" as="geometry"/></mxCell><mxCell id="sub-9" value="&lt;b style=&quot;font-size:15px&quot;&gt;Gestão&lt;/b&gt;&lt;br&gt;&lt;br&gt;Painel, relatórios, financeiro e automações apoiam decisões.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:11px&quot;&gt;Application/Dashboard · Reports · Finance · Automations&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="760" y="800" width="620" height="190" as="geometry"/></mxCell><mxCell id="sub-10" value="&lt;b&gt;Genérico&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1440" y="120" width="660" height="920" as="geometry"/></mxCell><mxCell id="sub-11" value="&lt;b style=&quot;font-size:15px&quot;&gt;Identidade e Equipe&lt;/b&gt;&lt;br&gt;&lt;br&gt;Login, perfis, convites, 2FA: igual em qualquer sistema.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:11px&quot;&gt;Domain/Identity · Team&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1460" y="170" width="620" height="190" as="geometry"/></mxCell><mxCell id="sub-12" value="&lt;b style=&quot;font-size:15px&quot;&gt;Notificações e e-mail&lt;/b&gt;&lt;br&gt;&lt;br&gt;Avisos internos e SMTP.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:11px&quot;&gt;Domain/Notifications&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1460" y="380" width="620" height="190" as="geometry"/></mxCell><mxCell id="sub-13" value="&lt;b style=&quot;font-size:15px&quot;&gt;Pagamentos (Pix simulado)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cobrança e confirmação; um PSP real substituiria a simulação.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:11px&quot;&gt;Domain/Portal (PortalCharge)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1460" y="590" width="620" height="190" as="geometry"/></mxCell><mxCell id="sub-14" value="&lt;b style=&quot;font-size:15px&quot;&gt;Documentos, Configurações e Auditoria&lt;/b&gt;&lt;br&gt;&lt;br&gt;PDF com código de verificação, parâmetros e trilha de auditoria.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:11px&quot;&gt;Domain/Documents · Settings · Audit&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1460" y="800" width="620" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="map" name="2. Mapa de Contextos"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1500" background="#FAFAF7" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="map-1" value="&lt;b style=&quot;font-size:24px&quot;&gt;Mapa de Contextos · mecanicaOS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;Aula 04. Cada seta vai do contexto Upstream (U) para o Downstream (D), com o padrão de integração e como o código integra de verdade.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2520" height="80" as="geometry"/></mxCell><mxCell id="map-2" value="&lt;b style=&quot;font-size:15px&quot;&gt;Ordens de Serviço&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:monospace&quot;&gt;Domain/ServiceOrders&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1050" y="520" width="300" height="110" as="geometry"/></mxCell><mxCell id="map-3" value="&lt;b style=&quot;font-size:15px&quot;&gt;Orçamentos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:monospace&quot;&gt;Domain/Quotes&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1050" y="860" width="300" height="110" as="geometry"/></mxCell><mxCell id="map-4" value="&lt;b style=&quot;font-size:15px&quot;&gt;Cadastros e Privacidade&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:monospace&quot;&gt;Domain/Customers · Privacy&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="300" height="110" as="geometry"/></mxCell><mxCell id="map-5" value="&lt;b style=&quot;font-size:15px&quot;&gt;Catálogo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:monospace&quot;&gt;Domain/Catalog&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1050" y="180" width="300" height="110" as="geometry"/></mxCell><mxCell id="map-6" value="&lt;b style=&quot;font-size:15px&quot;&gt;Estoque e Compras&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:monospace&quot;&gt;Domain/Inventory&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1800" y="300" width="300" height="110" as="geometry"/></mxCell><mxCell id="map-7" value="&lt;b style=&quot;font-size:15px&quot;&gt;Portal, Pagamentos e Documentos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:monospace&quot;&gt;Domain/Portal · Documents&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="860" width="300" height="110" as="geometry"/></mxCell><mxCell id="map-8" value="&lt;b style=&quot;font-size:15px&quot;&gt;Gestão&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:monospace&quot;&gt;Dashboard · Reports · Automations · Settings · Audit&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1800" y="860" width="300" height="110" as="geometry"/></mxCell><mxCell id="map-9" value="&lt;b style=&quot;font-size:15px&quot;&gt;Notificações&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:monospace&quot;&gt;Domain/Notifications&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1800" y="1150" width="300" height="110" as="geometry"/></mxCell><mxCell id="map-10" value="&lt;b style=&quot;font-size:15px&quot;&gt;Identidade e Equipe&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:monospace&quot;&gt;Domain/Identity · Team&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="1150" width="300" height="110" as="geometry"/></mxCell><mxCell id="map-11" value="&lt;b style=&quot;font-size:15px&quot;&gt;Shared Kernel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-family:monospace&quot;&gt;Domain/Common: Money, Quantity, Email, Result, AggregateRoot&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1E4E8;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1050" y="1200" width="300" height="110" as="geometry"/></mxCell><mxCell id="map-12" value="&lt;b&gt;ViaCEP&lt;/b&gt;&lt;br&gt;[Sistema externo]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F9B4D2;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="220" height="80" as="geometry"/></mxCell><mxCell id="map-13" value="&lt;b&gt;Servidor SMTP&lt;/b&gt;&lt;br&gt;[Sistema externo]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F9B4D2;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="2300" y="1150" width="240" height="80" as="geometry"/></mxCell><mxCell id="map-14" value="&lt;b&gt;Instituição de Pagamento (Pix)&lt;/b&gt;&lt;br&gt;[Sistema externo · confirmação simulada]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F9B4D2;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="300" height="80" as="geometry"/></mxCell><mxCell id="map-15" value="&lt;b&gt;WhatsApp&lt;/b&gt;&lt;br&gt;[Sistema externo · To be implemented]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F9B4D2;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="2300" y="120" width="260" height="80" as="geometry"/></mxCell><mxCell id="map-16" value="U → D · Cliente-Fornecedor&lt;br&gt;ServiceOrder.CustomerId / VehicleId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="map-4" target="map-2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="map-17" value="U → D · Conformista&lt;br&gt;ServiceItem / PartItem copiam nome e preço" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="map-5" target="map-2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="map-18" value="Parceria · mesma transação&lt;br&gt;QuoteApprovalPolicy → Part.DeductForServiceOrder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="map-2" target="map-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="map-19" value="U → D · Cliente-Fornecedor&lt;br&gt;Estimate.ServiceOrderId · QuoteDecider" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="map-2" target="map-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="map-20" value="U → D · Cliente-Fornecedor&lt;br&gt;sessão e cobrança por EstimateId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="map-3" target="map-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="map-21" value="U → D · eventos pelo Outbox&lt;br&gt;ServiceOrderStatusChanged · QuoteSent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin