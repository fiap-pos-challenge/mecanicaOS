# Line endings: every text file uses LF in the repository AND in the working copy, regardless of
# each machine's core.autocrlf. Only Windows-specific files (sln, ps1, cmd, bat) keep CRLF.
* text=auto eol=lf

# Source and project files
*.cs        text diff=csharp
*.csproj    text
*.slnx      text
*.sln       text eol=crlf
*.props     text
*.targets   text
*.json      text
*.xml       text
*.yml       text
*.yaml      text
*.md        text
*.sql       text
*.editorconfig text
Dockerfile  text

# Scripts executed inside Linux containers must keep LF.
*.sh        text eol=lf
# Windows scripts keep CRLF.
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.docx  binary
*.xlsx  binary
*.dll   binary
*.exe   binary
*.pfx   binary
